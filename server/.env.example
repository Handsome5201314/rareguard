# Node.js 24+. Copy to .env.family-public to use the existing environment loader.
# All relative paths resolve from the working directory used to start the process.
FAMILY_PORT=7870
FAMILY_DATA_DIR=family-data
# Optional: serve an existing frontend build. Omit for API-only mode.
# FAMILY_WEB_ROOT=../mas-scoring-tool/family-web-dist
# Configure these together only when enabling the authenticated reverse proxy.
# FAMILY_PUBLIC_ORIGIN=https://your-domain.example
# FAMILY_PROXY_TOKEN=replace-with-a-new-random-value
