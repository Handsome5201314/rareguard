# Copy to .env locally. All credentials and family identifiers start empty.
# Process environment overrides this file; RAREGUARD_CONFIG_FILE selects another explicit file.

# For scripts/local.py database: generate a private password locally (hex recommended).
RAREGUARD_LOCAL_POSTGRES_PASSWORD=
# Optional direct PostgreSQL URL; defaults to the local Docker database when the password above is set.
DATABASE_URL=
# Required for tests: postgresql+psycopg://...@127.0.0.1:<port>/rareguard_test
# Create this disposable database explicitly. Tests never infer it from DATABASE_URL.
TEST_DATABASE_URL=

# Console login is separate from App bearer credentials and requires HTTPS.
RAREGUARD_CONSOLE_URL=https://localhost:18443/console
RAREGUARD_PUBLIC_BASE_URL=https://localhost:18443/api
RAREGUARD_CONSOLE_USERNAME=
# Format: pbkdf2_sha256$310000$<hex salt>$<hex PBKDF2-SHA256 digest>
RAREGUARD_CONSOLE_PASSWORD_HASH=
# Private UUID shared by this console and its paired development guardians.
RAREGUARD_CONSOLE_FAMILY_ID=

# Optional real Hermes integration. Use a dedicated profile with tools and memory disabled.
HERMES_BASE_URL=
HERMES_API_KEY=
HERMES_MODEL=dravet-night
HERMES_PROFILE=dravet-night
HERMES_WEB_URL=
HERMES_RESTRICTED_CONTEXT_CONFIRMED=false
