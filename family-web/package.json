{
  "name": "@bingcheng/family-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Family medical timeline web client for the sibling server",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "npm run typecheck && vite build",
    "dev": "vite",
    "start": "node ../server/dist/src/server/main.js --web-root dist"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "lucide-react": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
